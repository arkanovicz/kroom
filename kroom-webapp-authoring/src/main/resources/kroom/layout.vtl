## The macros a page and the skeleton speak.
##
## #layout("sidebar") — the page's last word: the active theme's layout, rendered in the page's own context,
## where it writes the regions the page #define'd straight to the response. #layout() is the site's default.
#macro(layout $name)#parse($site.layout($name))#end
##
## #region("content") — one region of the skeleton, through the theme's partial when it has one
## (themes/<id>/regions/<name>.html), kroom's otherwise (kroom/regions/<name>.html).
#macro(region $name)#parse($site.region($name))#end
##
## #nav($nav.items) / #nav($nav.items, 2) — a menu tree as nested lists, down to a depth when one is given:
## the current page and its trail marked, a section nobody wrote leading to its first page (words only when it
## has none), a draft page (shown to its editors only) marked, each entry's description beside it for a theme
## that shows panels.
#macro(nav $items $depth)<ul>#foreach($item in $items)<li#if(!$item.children.isEmpty()) class="section"#end>#if($item.link)<a href="$item.link"#if($item.draft) class="draft"#end#if($nav.here == $item) aria-current="page"#elseif($nav.contains($item)) aria-current="true"#end#if($item.external) rel="external"#end>$item.label</a>#if($item.draft)<small class="draft">draft</small>#end#else<span#if($nav.contains($item)) aria-current="true"#end>$item.label</span>#end#if($item.description)<small>$item.description</small>#end#if(!$item.children.isEmpty())#if(!$depth)#nav($item.children)#elseif($depth > 1)#set($deeper = $depth - 1)#nav($item.children, $deeper)#end#end</li>#end</ul>#end
