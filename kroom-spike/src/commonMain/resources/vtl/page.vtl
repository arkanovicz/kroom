##@ state: com.republicate.kroom.spike.ChatView
##@ output: web
<span>$state.users.size</span> online
<ul id="users">#foreach($user in $state.users)<li id="users.$user.id" class="user $user.status">$user.name ($user.status)</li>#end</ul>
<ul id="chat">#foreach($c in $state.history)<li>$c.author: $c.text</li>#end</ul>
#if($state.users.size > 1)<p>company</p>#end
